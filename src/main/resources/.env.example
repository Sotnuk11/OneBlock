# Existing database, separate OneBlock schema and application role.
# localhost refers to the Minecraft server when PostgreSQL runs on that same server.
ONEBLOCK_DB_HOST=127.0.0.1
ONEBLOCK_DB_PORT=5432
ONEBLOCK_DB_NAME=oneblock
ONEBLOCK_DB_SCHEMA=oneblock
ONEBLOCK_DB_USER=oneblock_app
ONEBLOCK_DB_PASSWORD=
ONEBLOCK_DB_SSLMODE=prefer
ONEBLOCK_DB_CHANNEL_BINDING=prefer
ONEBLOCK_DB_TIMEOUT_SECONDS=10
ONEBLOCK_DB_SOCKET_TIMEOUT_SECONDS=30
ONEBLOCK_DB_HEARTBEAT_SECONDS=10
ONEBLOCK_DB_RETRY_SECONDS=5
