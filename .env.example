# Deploy as plugins/one-block/.env on the OneBlock backend. Use a separate database/user from authentication.
ONEBLOCK_DB_HOST=127.0.0.1
ONEBLOCK_DB_PORT=5432
ONEBLOCK_DB_NAME=oneblock
ONEBLOCK_DB_USER=oneblock_app
ONEBLOCK_DB_PASSWORD=
ONEBLOCK_DB_SSLMODE=require
ONEBLOCK_DB_CHANNEL_BINDING=require
ONEBLOCK_DB_TIMEOUT_SECONDS=10
